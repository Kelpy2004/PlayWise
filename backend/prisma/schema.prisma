generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  MICROSOFT
  APPLE
}

enum ReactionKind {
  LIKE
  DISLIKE
}

enum RecommendationDecision {
  BUY_NOW
  WAIT_FOR_SALE
  SKIP
  TRY_ALTERNATIVE
}

enum PriceTimingDecision {
  BUY_NOW
  WAIT_FOR_DROP
  WATCH_CLOSELY
  FAIR_PRICE
}

enum NotificationChannel {
  EMAIL
}

enum NotificationType {
  PRICE_DROP
  PRICE_TARGET
  TOURNAMENT_SOON
  TOURNAMENT_LIVE
  NEWSLETTER
  DEAL_ALERT
}

enum DealType {
  FREE_GAME
  DISCOUNT
  MISSION_FREE
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum TournamentStatus {
  UPCOMING
  LIVE_NOW
  ENDED
}

enum TournamentSubscriptionScope {
  ALL
  GAME
}

model User {
  id                  String                   @id @default(cuid())
  username            String                   @unique
  email               String                   @unique
  passwordHash        String
  role                UserRole                 @default(USER)
  verified            Boolean                  @default(false)
  avatarUrl           String                   @default("")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  comments            Comment[]
  favoriteGames       FavoriteGame[]
  gameReactions       GameReaction[]
  commentReactions    CommentReaction[]
  gameViews           GameView[]
  recommendationRuns  RecommendationSnapshot[]
  telemetryEvents     TelemetryEvent[]
  providerAccounts    ProviderAccount[]
  emailVerificationTokens EmailVerificationToken[]
  priceAlerts         PriceAlert[]
  newsletterRecords   NewsletterSubscriber[]
  tournamentSubscriptions TournamentSubscription[]
  notificationDeliveries NotificationDelivery[]
  dealSubscriptions      DealSubscription[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId     String
  email      String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

model ProviderAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String?
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Game {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  year               Int?
  heroTag            String?
  description        String?
  catalogSource      String?
  catalogBuckets     String[]
  popularityScore    Float?
  releaseTimestamp   DateTime?
  externalRatingCount Int?
  genres             String[]
  platforms          String[]
  supportedPlatforms String[]
  stores             String[]
  averageRating      Float?
  image              String?
  banner             String?
  payload            Json?
  imdbRatingRank     Int?
  imdbPopularityRank Int?
  imdbRating         Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([title])
  @@index([catalogSource])
  @@index([averageRating])
  @@index([popularityScore])
  @@index([releaseTimestamp])
  @@index([imdbRatingRank])
  @@index([imdbPopularityRank])
}

model Comment {
  id           String            @id @default(cuid())
  gameSlug      String
  username      String
  message       String
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  likeCount     Int               @default(0)
  dislikeCount  Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  reactions     CommentReaction[]

  @@index([gameSlug, createdAt])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model FavoriteGame {
  id        String   @id @default(cuid())
  userId    String
  gameSlug  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameSlug])
  @@index([gameSlug])
}

model GameReaction {
  id        String        @id @default(cuid())
  userId    String
  gameSlug   String
  reaction  ReactionKind
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameSlug])
  @@index([gameSlug])
}

model CommentReaction {
  id         String        @id @default(cuid())
  userId     String
  commentId  String
  reaction   ReactionKind
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment    Comment       @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model GameView {
  id         String    @id @default(cuid())
  userId     String?
  sessionId  String?
  gameSlug   String
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameSlug, createdAt])
}

model TelemetryEvent {
  id         String   @id @default(cuid())
  category   String
  action     String
  label      String?
  path       String?
  sessionId  String?
  meta       Json?
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, action, createdAt])
}

model RecommendationSnapshot {
  id              String                  @id @default(cuid())
  userId          String?
  sessionId       String?
  gameSlug        String
  decision        RecommendationDecision
  confidence      Float
  summary         String
  reasons         Json
  alternativeSlug String?
  createdAt       DateTime                @default(now())
  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameSlug, createdAt])
}

model PriceHistoryEntry {
  id            String   @id @default(cuid())
  gameSlug      String
  store         String?
  amount        Float
  regularAmount Float?
  cut           Int?
  currency      String?
  recordedAt    DateTime
  source        String   @default("IsThereAnyDeal API")
  createdAt     DateTime @default(now())

  @@index([gameSlug, recordedAt])
}

model PriceTimingSnapshot {
  id                String              @id @default(cuid())
  gameSlug          String              @unique
  decision          PriceTimingDecision
  confidence        Float
  dropProbability   Float
  expectedWindowDays Int?
  currentAmount     Float?
  historicalLowAmount Float?
  average30Amount   Float?
  average90Amount   Float?
  currency          String?
  summary           String
  reasons           Json
  stats             Json?
  generatedAt       DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([decision, updatedAt])
}

model PriceAlert {
  id                String   @id @default(cuid())
  userId            String?
  email             String
  gameSlug          String
  targetPrice       Float?
  isActive          Boolean  @default(true)
  lastTriggeredAt   DateTime?
  lastNotifiedPrice Float?
  lastSeenPrice     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameSlug, isActive])
  @@index([email, gameSlug])
  @@index([userId, isActive])
}

model NewsletterSubscriber {
  id             String   @id @default(cuid())
  userId         String?
  email          String   @unique
  isSubscribed   Boolean  @default(true)
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isSubscribed, updatedAt])
}

model Tournament {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  gameSlug    String?
  status      TournamentStatus @default(UPCOMING)
  startsAt    DateTime
  endsAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  subscriptions TournamentSubscription[]
  deliveries  NotificationDelivery[]

  @@index([status, startsAt])
  @@index([gameSlug, startsAt])
}

model TournamentSubscription {
  id                  String                      @id @default(cuid())
  userId              String?
  email               String
  scope               TournamentSubscriptionScope @default(ALL)
  gameSlug            String?
  isActive            Boolean                     @default(true)
  lastSoonNotifiedAt  DateTime?
  lastLiveNotifiedAt  DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  user                User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tournamentId        String?
  tournament          Tournament?                 @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([isActive, scope, gameSlug])
  @@index([email, isActive])
  @@index([userId, isActive])
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  type           NotificationType
  channel        NotificationChannel @default(EMAIL)
  status         DeliveryStatus      @default(PENDING)
  recipientEmail String
  userId         String?
  gameSlug       String?
  tournamentId   String?
  payload        Json?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  tournament     Tournament?         @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([recipientEmail, createdAt])
}

model Deal {
  id            String    @id @default(cuid())
  externalId    String    @unique
  type          DealType
  title         String
  gameSlug      String?
  store         String
  originalPrice Float?
  dealPrice     Float?
  discountPct   Int?
  currency      String    @default("USD")
  url           String
  imageUrl      String?
  startsAt      DateTime?
  endsAt        DateTime?
  source        String
  metadata      Json?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type, isActive])
  @@index([store, isActive])
  @@index([gameSlug, isActive])
  @@index([endsAt])
}

model DealSubscription {
  id              String    @id @default(cuid())
  userId          String?
  email           String
  minDiscountPct  Int       @default(75)
  notifyFreeGames Boolean   @default(true)
  notifyDiscounts Boolean   @default(true)
  isActive        Boolean   @default(true)
  lastNotifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isActive, email])
  @@index([userId, isActive])
}
